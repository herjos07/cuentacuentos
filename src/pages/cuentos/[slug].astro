---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const cuentos = await getCollection('cuentos');
  return cuentos.map(entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

// Fecha en formato ISO para datos estructurados y article:published_time
const fechaISO = new Date(entry.data.date).toISOString();

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ShortStory",
  "headline": entry.data.title,
  "description": entry.data.description,
  "genre": entry.data.category,
  "datePublished": fechaISO,
  "inLanguage": "es",
  "author": {
    "@type": "Organization",
    "name": "HerJos Cuentacuentos"
  },
  "publisher": {
    "@type": "Organization",
    "name": "HerJos",
    "logo": {
      "@type": "ImageObject",
      "url": "https://herjos.com/logoherjos.png"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `https://herjos.com/cuentacuentos/cuentos/${entry.slug}`
  }
};
---

<Layout
  title={entry.data.title}
  description={entry.data.description}
  type="article"
  publishedTime={fechaISO}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <article class="cuento-card">
    <header class="cuento-header">
      <h1>{entry.data.title}</h1>
      <div class="meta">
        <span>📅 {entry.data.date}</span> | <span>🏷️ {entry.data.category}</span>
      </div>
    </header>

    <div class="cuento-contenido">
      <Content />
    </div>

    <!-- Anuncio al final del cuento -->
    <div class="ad-container">
      <p class="ad-label">Publicidad</p>
      <ins class="adsbygoogle"
           style="display:block"
           data-ad-client="ca-pub-8110695346048617"
           data-ad-slot="6900639161"
           data-ad-format="auto"
           data-full-width-responsive="true"></ins>
      <script is:inline>
           (adsbygoogle = window.adsbygoogle || []).push({});
      </script>
    </div>
  </article>

  <a href="/cuentacuentos/" class="btn back-link">← Volver al inicio</a>
</Layout>

<style>
  .cuento-header {
    text-align: center;
    border-bottom: 1px solid #e2e2e2;
    padding-bottom: 1.2rem;
    margin-bottom: 1.5rem;
  }

  .meta {
    font-size: 0.9rem;
    color: #777;
    font-family: system-ui, sans-serif;
    margin-top: 0.5rem;
  }

  .cuento-contenido {
    font-family: 'Georgia', serif;
    line-height: 1.8;
    font-size: 1.05rem;
  }

  .cuento-contenido :global(p) {
    margin-bottom: 1.1rem;
  }

  .ad-container {
    margin: 2rem 0 0.5rem;
    text-align: center;
    min-height: 90px;
  }

  .ad-label {
    font-size: 0.75rem;
    color: #999;
    margin-bottom: 4px;
    font-family: system-ui, sans-serif;
  }

  .back-link {
    display: block;
    width: fit-content;
    margin: 0 auto;
  }
</style>
