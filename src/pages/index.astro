---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

// Obtener todos los cuentos y ordenarlos del más reciente al más antiguo
const cuentos = await getCollection('cuentos');
cuentos.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
---

<Layout title="Cuentos Diarios">
  <div class="hero-section">
    <h1>📖 Cuentacuentos Diarios</h1>
    <p>Historias originales generadas día con día.</p>
  </div>

  <div class="cuentos-list">
    {cuentos.length === 0 ? (
      <div class="cuento-card text-center">
        <p>Aún no hay cuentos publicados. ¡Regresa más tarde!</p>
      </div>
    ) : (
      cuentos.map((cuento) => (
        <article class="cuento-card">
          <h2>{cuento.data.title}</h2>
          <p class="fecha">🗓️ {cuento.data.date}</p>
          <p class="resumen">{cuento.data.description}</p>
          <a href={`/cuentacuentos/cuentos/${cuento.slug}`} class="btn">
            Leer cuento
          </a>
        </article>
      ))
    )}
  </div>

  <!-- Anuncio al final del catálogo de cuentos -->
  <div style="margin-top: 40px; text-align: center; min-height: 90px;">
    <p style="font-size: 12px; color: #888; margin-bottom: 5px;">Publicidad</p>
    <ins class="adsbygoogle"
         style="display:block"
         data-ad-client="ca-pub-8110695346048617"
         data-ad-slot="6900639161"
         data-ad-format="auto"
         data-full-width-responsive="true"></ins>
    <script is:inline>
         (adsbygoogle = window.adsbygoogle || []).push({});
    </script>
  </div>
</Layout>

<style>
  .hero-section {
    text-align: center;
    margin-bottom: 40px;
  }

  .hero-section h1 {
    font-family: 'Playfair Display', serif;
    font-size: 38px;
    color: #0A1A3F;
    margin-bottom: 10px;
  }

  .hero-section p {
    color: #555;
    font-size: 16px;
  }

  .cuentos-list {
    width: 100%;
    max-width: 800px;
    margin: 0 auto;
  }

  .cuento-card h2 {
    font-size: 24px;
    margin-bottom: 5px;
  }

  .fecha {
    color: #C9A646;
    font-size: 13px;
    font-weight: 600;
    margin-bottom: 15px;
  }

  .resumen {
    color: #555;
    margin-bottom: 20px;
    line-height: 1.6;
  }

  .text-center {
    text-align: center;
  }
</style>
